+int classicRoleCount(GameLogic &logic, const Player &player, int role)
+{
+ int count=0;
+ for (Object *o=logic.getFirstObject();o;o=o->getNextObject()) {
+  if (o->getControllingPlayer()!=&player || o->isEffectivelyDead() || o->isDestroyed()) continue;
+  if (!o->isKindOfName("STRUCTURE") && !o->isKindOfName("HERO") && (!o->getHordeObject(false) || o->getHordeObject(false)==o) && AIThreatFinder::threatCategory(*o->getTemplate())==role) ++count;
+  if (auto *pu=o->getProductionUpdate()) for (auto *e=pu->firstProduction();e;e=pu->nextProduction(e))
+   { if (e->objectToProduce && AIThreatFinder::threatCategory(*e->objectToProduce)==role) ++count;
+     if (e->upgradeToResearch) { const auto &name=e->upgradeToResearch->getUpgradeName(); if ((role==1 && name=="Upgrade_ThrallMasterRhudaurSlingers") || (role==3 && name=="Upgrade_ThrallMasterWolfRiders")) ++count; }
+   }
+ }
+ return count;
+}
