+Dictionary GameWorld::debug_command_point_probe(int64_t id)
+{
+	Dictionary out; out["ok"]=false;
+	if (!m_game || !m_testHooks || m_netHost || m_netClient || m_netStarted || m_netSession || m_game->logicThread()) { out["error"]="test_hooks required, without network or logic worker"; return out; }
+	const auto worldContext=m_world ? m_world->enterContext() : nullptr;
+	::Object *o=m_game->logic().findObjectByID((::ObjectID)id);
+	::Player *owner=o ? o->getControllingPlayer() : nullptr;
+	if (!owner || o->isEffectivelyDead() || !o->isCountedInCommandPoints() || m_game->logic().economy().commandPointUsageOf(*o)<=0) { out["error"]="probe requires a live registered CP unit"; return out; }
+	const char *missing="__AI_TEST_MISSING_MODIFIER__";
+	const int before=owner->commandPoints().getUsage();
+	bool rejected=true;
+	for (int i=0;i<8;++i) rejected &= !o->addAttributeModifier(missing,-1);
+	const int afterRejected=owner->commandPoints().getUsage();
+	o->removeFromPlayerCommandPoints();
+	const int released=owner->commandPoints().getUsage();
+	for (int i=0;i<8;++i) { rejected &= !o->addAttributeModifier(missing,-1); o->removeAttributeModifier(missing); }
+	const int whileUnregistered=owner->commandPoints().getUsage();
+	const bool stayedUnregistered=!o->isCountedInCommandPoints();
+	o->addToPlayerCommandPoints();
+	const int restored=owner->commandPoints().getUsage();
+	out["before"]=before;out["after_rejected"]=afterRejected;out["released"]=released;
+	out["while_unregistered"]=whileUnregistered;out["restored"]=restored;out["all_rejected"]=rejected;
+	out["stayed_unregistered"]=stayedUnregistered;
+	out["ok"]=rejected && afterRejected==before && whileUnregistered==released && stayedUnregistered && restored==before;
+	return out;
+}
