@@ -0,0 +1,255 @@
+// OpenBFME. GPL-3.0. Opt-in, read-only local-human training telemetry.
+// Runs on the command dispatcher's logic thread; no Godot objects or disk IO here.
+#include "GameLogic/GameLogicDispatch.h"
+#include "Common/Player.h"
+#include "Common/BuildAssistant.h"
+#include "GameClient/ControlBarCommands.h"
+#include "Common/PlayerList.h"
+#include "Common/PlayerTemplate.h"
+#include "Common/Science.h"
+#include "Common/SpecialPower.h"
+#include "Common/Upgrade.h"
+#include "Common/Thing/ThingTemplate.h"
+#include "Common/Thing/ThingFactory.h"
+#include "GameLogic/Economy.h"
+#include "GameLogic/GameLogic.h"
+#include "GameLogic/Module/AIUpdate.h"
+#include "GameLogic/Module/BehaviorModule.h"
+#include "GameLogic/Module/ProductionUpdate.h"
+#include "GameLogic/Module/SpecialPowerModules.h"
+#include "GameLogic/Object/Object.h"
+#include "GameLogic/Object/ExperienceTracker.h"
+#include "GameLogic/System/ShroudManager.h"
+#include "GameLogic/System/InvisibilityManager.h"
+#include <cmath>
+#include <locale>
+#include <sstream>
+
+namespace
+{
+std::string quoted(const std::string &text)
+{
+	std::string out = "\"";
+	for (unsigned char ch : text)
+	{
+		if (ch == '"' || ch == '\\') { out += '\\'; out += (char)ch; }
+		else if (ch < 32) { const char *hex = "0123456789abcdef"; out += "\\u00"; out += hex[ch >> 4]; out += hex[ch & 15]; }
+		else out += (char)ch;
+	}
+	return out + "\"";
+}
+double finite(float value) { return std::isfinite(value) ? value : 0.0; }
+bool human(const Player *p) { return p && p->getPlayerType() == PLAYER_HUMAN && p->getPlayerTemplate() && p->getPlayerTemplate()->m_playableSide && !p->isObserver(); }
+bool visible(GameLogic &logic, const Object &object, const Player &observer)
+{
+	if (object.getControllingPlayer() == &observer) return true;
+	if (object.getContainedBy() || !logic.shroud()) return false;
+	for (int i = 1; i < logic.players().getPlayerCount(); ++i)
+	{
+		const Player *viewer = logic.players().getNthPlayer(i);
+		if (!viewer || !viewer->getPlayerTemplate() || !viewer->getPlayerTemplate()->m_playableSide || viewer->isObserver() || viewer->isDefeated() || (viewer != &observer && observer.getRelationship(viewer) != ALLIES)) continue;
+		if (logic.shroud()->clientObjectStatus(object, i) < OBJECTSHROUD_FOGGED && InvisibilityManager::clientLook(object, viewer) != 5) return true;
+	}
+	return false;
+}
+void writeSelection(std::ostream &out, GameLogic &logic, const Player &p)
+{
+	out << '['; bool comma = false;
+	for (ObjectID id : p.selection())
+	{
+		const Object *o = logic.findObjectByID(id);
+		if (!o || !visible(logic, *o, p)) continue;
+		if (comma) out << ','; comma = true; out << id;
+	}
+	out << ']';
+}
+void resources(std::ostream &out, const Player &p)
+{
+	out << "\"money\":" << p.getMoney()->countMoney() << ",\"cp_used\":" << p.commandPoints().getUsage() << ",\"cp_limit\":" << p.commandPointLimit();
+}
+void queue(std::ostream &out, const Object &o)
+{
+	out << '['; bool comma = false;
+	if (const ProductionUpdateInterface *production = o.getProductionUpdate())
+		for (const ProductionEntry *e = production->firstProduction(); e; e = production->nextProduction(e))
+		{
+			if (comma) out << ','; comma = true;
+			out << "{\"id\":" << e->productionID << ",\"kind\":" << (int)e->type << ",\"percent\":" << finite(e->percentComplete)
+				<< ",\"remaining\":" << e->quantityRemaining() << ",\"template\":" << quoted(e->objectToProduce ? e->objectToProduce->getName() : "")
+				<< ",\"upgrade\":" << quoted(e->upgradeToResearch ? e->upgradeToResearch->getUpgradeName() : "") << '}';
+		}
+	out << ']';
+}
+}
+
+void GameLogicDispatch::humanRecord(std::string row)
+{
+	// A stalled consumer cannot grow memory without bound; every loss is reported.
+	if (m_humanBytes + row.size() > 8 * 1024 * 1024) { ++m_humanDropped; return; }
+	m_humanBytes += row.size(); m_humanRecords.push_back(std::move(row));
+}
+
+std::vector<std::string> GameLogicDispatch::takeHumanCapture()
+{
+	std::vector<std::string> result; result.swap(m_humanRecords); m_humanBytes = 0;
+	if (m_humanDropped) { result.push_back("{\"event\":\"capture_gap\",\"dropped_records\":" + std::to_string(m_humanDropped) + "}"); m_humanDropped = 0; }
+	return result;
+}
+
+void GameLogicDispatch::captureHumanState(Player &p, const char *reason)
+{
+	std::ostringstream out; out.imbue(std::locale::classic());
+	out << "{\"event\":\"human_state\",\"frame\":" << m_logic.getFrame() << ",\"player\":" << p.getPlayerIndex()
+		<< ",\"command_id\":" << (std::string(reason) == "before_command" ? m_humanSequence + 1 : 0)
+		<< ",\"reason\":" << quoted(reason) << ",\"faction\":" << quoted(p.getPlayerTemplate()->getName()) << ',';
+	resources(out, p);
+	out << ",\"defeated\":" << (p.isDefeated() ? "true" : "false") << ",\"selection\":"; writeSelection(out, m_logic, p);
+	const PlayerScience &science = p.science();
+	out << ",\"science\":{\"rank\":" << science.getRankLevel() << ",\"points\":" << science.getSciencePurchasePoints() << ",\"skill_points\":" << science.getSkillPoints() << ",\"owned\":[";
+	bool comma = false;
+	for (ScienceType st : science.sciences()) { if (comma) out << ','; comma = true; out << quoted(TheScienceStore ? TheScienceStore->getInternalNameForScience(st) : std::to_string(st)); }
+	out << "]},\"player_upgrades\":["; comma = false;
+	if (TheUpgradeCenter) for (unsigned bit = 0; bit < UpgradeMaskType::BITS; ++bit)
+	{
+		const UpgradeTemplate *upgrade = TheUpgradeCenter->findUpgradeByMaskBit((int)bit);
+		if (!upgrade || !p.hasUpgradeComplete(upgrade)) continue;
+		if (comma) out << ','; comma = true; out << quoted(upgrade->getUpgradeName());
+	}
+	out << "],\"objects\":["; comma = false;
+	for (const Object *o = m_logic.getFirstObject(); o; o = o->getNextObject())
+	{
+		const bool own = o->getControllingPlayer() == &p;
+		if (o->isEffectivelyDead() || o->isDestroyed() || !visible(m_logic, *o, p)) continue;
+		if (own && !o->isKindOfName("STRUCTURE") && !o->isKindOfName("CAN_ATTACK") && !o->isKindOfName("DOZER") && !o->isKindOfName("HERO") && !o->isKindOfName("SUPPORT"))
+		{
+			bool hasPower = false; for (const auto &module : o->modules()) if (module->getSpecialPower()) { hasPower = true; break; }
+			if (!hasPower) continue;
+		}
+		if (o->getContainedBy() && (!own || o->getContainedBy()->isKindOfName("HORDE"))) continue;
+		if (!own && !o->isKindOfName("STRUCTURE") && !o->isKindOfName("CAN_ATTACK") && !o->isKindOfName("DOZER") && !o->isKindOfName("HERO")) continue;
+		if (comma) out << ','; comma = true;
+		const Player *owner = o->getControllingPlayer();
+		out << "{\"id\":" << o->getID() << ",\"owner\":" << (owner ? owner->getPlayerIndex() : -1)
+			<< ",\"relation\":" << quoted(own ? "self" : owner && p.getRelationship(owner) == ALLIES ? "ally" : owner && p.getRelationship(owner) == ENEMIES ? "enemy" : "neutral")
+			<< ",\"template\":" << quoted(o->getTemplate()->getName()) << ",\"x\":" << finite(o->getPosition()->x) << ",\"y\":" << finite(o->getPosition()->y)
+			<< ",\"structure\":" << (o->isKindOfName("STRUCTURE") ? "true" : "false") << ",\"hero\":" << (o->isKindOfName("HERO") ? "true" : "false")
+			<< ",\"complete\":" << (!o->isUnderConstruction() ? "true" : "false");
+		if (const BodyModuleInterface *body = o->getBodyModule()) out << ",\"health_ratio\":" << (body->getMaxHealth() > 0 ? finite(body->getHealth() / body->getMaxHealth()) : 0);
+		if (o->isKindOfName("HORDE") && o->getContain())
+		{
+			float health = 0, maximum = 0; unsigned count = 0;
+			if (const auto *members = o->getContain()->getContainedItemsList()) for (const Object *member : *members)
+				if (member && !member->isEffectivelyDead() && member->getBodyModule()) { health += member->getBodyModule()->getHealth(); maximum += member->getBodyModule()->getMaxHealth(); ++count; }
+			out << ",\"member_count\":" << count << ",\"member_health\":" << finite(health) << ",\"member_max_health\":" << finite(maximum);
+		}
+		if (own)
+		{
+			out << ",\"command_set\":" << quoted(o->getCommandSetName()) << ",\"contained_by\":" << (o->getContainedBy() ? o->getContainedBy()->getID() : 0) << ",\"moving\":" << (o->getAIUpdateInterface() && o->getAIUpdateInterface()->isMoving() ? "true" : "false") << ",\"queue\":";
+			queue(out, *o);
+			if (const ExperienceTracker *xp = o->getExperienceTracker()) out << ",\"rank\":" << xp->getRank();
+			out << ",\"upgrades\":["; bool upgradeComma = false;
+			if (TheUpgradeCenter) for (unsigned bit = 0; bit < UpgradeMaskType::BITS; ++bit)
+			{
+				if (!o->getUpgradeMask().test(bit)) continue;
+				const UpgradeTemplate *u = TheUpgradeCenter->findUpgradeByMaskBit((int)bit); if (!u) continue;
+				if (upgradeComma) out << ','; upgradeComma = true; out << quoted(u->getUpgradeName());
+			}
+			out << "],\"powers\":["; bool powerComma = false;
+			for (const auto &module : o->modules())
+			{
+				const SpecialPowerModuleInterface *power = module->getSpecialPower();
+				if (!power) continue;
+				if (powerComma) out << ','; powerComma = true;
+				out << "{\"name\":" << quoted(power->getSpecialPowerTemplate() ? power->getSpecialPowerTemplate()->getName() : "") << ",\"ready\":" << (power->isReadyForDisplay() ? "true" : "false") << ",\"percent\":" << finite(power->getPercentReadyForDisplay()) << '}';
+			}
+			out << ']';
+		}
+		out << '}';
+	}
+	out << "],\"selected_build_options\":["; comma = false;
+	for (ObjectID id : p.selection())
+	{
+		Object *producer = m_logic.findObjectByID(id);
+		if (!producer || producer->getControllingPlayer() != &p || !TheCommandStore) continue;
+		const CommandSet *set = TheCommandStore->findCommandSet(producer->getCommandSetName()); if (!set) continue;
+		for (int slot = 0; slot < CommandSet::slotCapacity(); ++slot)
+		{
+			const CommandButton *button = set->getCommandButton(slot);
+			if (!button || (button->m_command != GUI_COMMAND_UNIT_BUILD && button->m_command != GUI_COMMAND_DOZER_CONSTRUCT)) continue;
+			const ThingTemplate *tt = button->getThingTemplate(); if (!tt) continue;
+			if (comma) out << ','; comma = true;
+			out << "{\"producer\":" << id << ",\"slot\":" << slot << ",\"template\":" << quoted(tt->getName()) << ",\"cost\":" << BuildAssistant::calcCostToBuild(*tt, &p, producer, -1)
+				<< ",\"can_make\":" << (int)BuildAssistant::canMakeUnit(*producer, tt, -1) << '}';
+		}
+		break;
+	}
+	out << "]}";
+	humanRecord(out.str());
+	m_humanLastSample[p.getPlayerIndex()] = m_logic.getFrame();
+}
+
+void GameLogicDispatch::sampleHumanCapture()
+{
+	if (!m_humanCapture) return;
+	for (int i = 1; i < m_logic.players().getPlayerCount(); ++i)
+	{
+		Player *p = m_logic.players().getNthPlayer(i);
+		const auto previous = m_humanLastSample.find(i);
+		if (human(p) && (previous == m_humanLastSample.end() || m_logic.getFrame() - previous->second >= 5)) captureHumanState(*p, "periodic");
+	}
+}
+
+bool GameLogicDispatch::captureHumanBefore(const GameMessage &message)
+{
+	Player *p = m_logic.players().getNthPlayer(message.getPlayerIndex());
+	if (!human(p) || message.getType() == MSG_LOGIC_CRC || message.getType() == MSG_SET_REPLAY_CAMERA) return false;
+	const bool select = message.getType() >= MSG_CREATE_SELECTED_GROUP && message.getType() <= MSG_ADD_TEAM9;
+	if (!select) captureHumanState(*p, "before_command");
+	std::ostringstream out; out.imbue(std::locale::classic());
+	out << "{\"event\":\"human_command\",\"id\":" << ++m_humanSequence << ",\"frame\":" << m_logic.getFrame() << ",\"player\":" << p->getPlayerIndex()
+		<< ",\"type\":" << message.getType() << ",\"command\":" << quoted(GameMessageTypeName(message.getType())) << ",\"selection_before\":";
+	writeSelection(out, m_logic, *p); out << ','; resources(out, *p); out << ",\"args\":[";
+	for (size_t i = 0; i < message.getArgumentCount(); ++i)
+	{
+		if (i) out << ','; const GameMessageArgument &a = *message.getArgument(i);
+		out << "{\"type\":" << (int)a.type << ",\"value\":";
+		if (a.type == ARGUMENTDATATYPE_OBJECTID)
+		{
+			const Object *target = m_logic.findObjectByID(a.objectID);
+			if (!a.objectID || (target && visible(m_logic, *target, *p))) out << a.objectID;
+			else out << "null,\"redacted\":true";
+		}
+		else if (a.type == ARGUMENTDATATYPE_LOCATION) out << "{\"x\":" << finite(a.location.x) << ",\"y\":" << finite(a.location.y) << '}';
+		else if (a.type == ARGUMENTDATATYPE_REAL) out << finite(a.real);
+		else if (a.type == ARGUMENTDATATYPE_BOOLEAN) out << (a.boolean ? "true" : "false");
+		else if (a.type == ARGUMENTDATATYPE_WIDECHAR) out << "null"; // no chat / arbitrary text collection
+		else out << a.integer;
+		out << '}';
+	}
+	out << ']';
+	const GameMessageArgument *templateArg = nullptr;
+	if (message.getType() == MSG_DOZER_CONSTRUCT || message.getType() == MSG_FOUNDATION_CONSTRUCT) templateArg = message.getArgument(0);
+	if (message.getType() == MSG_QUEUE_UNIT_CREATE && message.getArgument(0) && message.getArgument(0)->type == ARGUMENTDATATYPE_BOOLEAN && !message.getArgument(0)->boolean) templateArg = message.getArgument(1);
+	if (templateArg && templateArg->type == ARGUMENTDATATYPE_INTEGER)
+		if (const ThingTemplate *tt = m_logic.things().findByTemplateID((unsigned short)templateArg->integer)) out << ",\"requested_template\":" << quoted(tt->getName());
+	out << ",\"label_quality\":\"human_attempt_not_verified_good\"}";
+	humanRecord(out.str()); return true;
+}
+
+void GameLogicDispatch::captureHumanAfter(const GameMessage &message, size_t errorsBefore, unsigned long long unhandledBefore)
+{
+	const Player *p = m_logic.players().getNthPlayer(message.getPlayerIndex()); if (!p) return;
+	const auto it = m_unhandled.find(message.getType());
+	const bool rejected = m_errors.size() != errorsBefore || (it != m_unhandled.end() && it->second > unhandledBefore);
+	std::ostringstream out; out.imbue(std::locale::classic());
+	out << "{\"event\":\"human_command_result\",\"id\":" << m_humanSequence << ",\"frame\":" << m_logic.getFrame() << ",\"player\":" << p->getPlayerIndex()
+		<< ",\"dispatcher_error\":" << (rejected ? "true" : "false") << ",\"success_verified\":false,";
+	resources(out, *p); out << ",\"selection_after\":"; writeSelection(out, m_logic, *p);
+	out << ",\"selected_queues\":["; bool comma = false;
+	for (ObjectID id : p->selection())
+	{
+		const Object *o = m_logic.findObjectByID(id); if (!o || o->getControllingPlayer() != p || !o->getProductionUpdate()) continue;
+		if (comma) out << ','; comma = true; out << "{\"producer\":" << id << ",\"queue\":"; queue(out, *o); out << '}';
+	}
+	out << "]}"; humanRecord(out.str());
+}
diff --git a/engine/src/GameLogic/SkirmishAI/CounterProduction.h b/engine/src/GameLogic/SkirmishAI/CounterProduction.h
new file mode 100644
--- /dev/null
+++ b/engine/src/GameLogic/SkirmishAI/CounterProduction.h
@@ -0,0 +1,35 @@
+// OpenBFME enhanced AI policy, intentionally different from retail 2.01.
+#pragma once
+#include <cstdint>
+
+namespace CounterProduction
+{
+inline int personality(std::uint32_t seed, int player)
+{
+	std::uint32_t x = seed ^ ((std::uint32_t)player * 0x9e3779b9u);
+	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15;
+	return (int)(x % 3u); // aggressive, defensive, balanced; no simulation RNG draw
+}
+
+inline bool siegeAllowed(int ownArmy, int enemyArmy, int homeThreats, bool knownBuilding)
+{
+	return knownBuilding && ownArmy >= 6 && homeThreats < 2 && ownArmy * 4 >= enemyArmy * 5;
+}
+struct SeenArmy
+{
+	int infantry = 0, archers = 0, pikes = 0, cavalry = 0;
+	int total() const { return infantry + archers + pikes + cavalry; }
+};
+
+// AIThreatFinder categories: infantry 0, archer 1, pikeman 2, cavalry 3.
+inline float weight(int role, const SeenArmy &seen)
+{
+	if (seen.total() == 0) return 1.0f; // no information is not proof of no counters
+	if (role == 2 && seen.cavalry > 0) return 4.0f;
+	if (role == 3 && seen.pikes > 0) return 0.2f;
+	if (role == 3 && seen.pikes == 0 && (seen.archers > 0 || seen.infantry > 0)) return 2.5f;
+	if (role == 1 && seen.pikes > 0) return 2.0f;
+	if (role == 1 && seen.infantry > seen.archers) return 1.5f;
+	return 1.0f;
+}
+}
diff --git a/engine/src/GameLogic/SkirmishAI/EnhancedStrategy.h b/engine/src/GameLogic/SkirmishAI/EnhancedStrategy.h
new file mode 100644
