 // RW 0x8EEC71: the nearest free farm site away from the enemy's fortress (900) and with no enemy within DefenseTreeNodeRadius
+float classicFarmQuality(GameLogic &logic, const Player &player, const ThingTemplate &tt, const Coord3D &at)
+{
+	const auto *data = TerrainResourceClaimView::resourceDataOf(tt);
+	if (!data || data->m_maxIncome <= 0 || !logic.shroud() || logic.shroud()->getStatusAt(player.getPlayerIndex(), at.x, at.y) != CELLSHROUD_CLEAR) return 0;
+	// Include unfinished friendly farms: a provisional grid claim must not allow
+	// two simultaneous farms to be placed on the same resource disc.
+	for (const Object *o = logic.getFirstObject(); o; o = o->getNextObject())
+	{
+		const Player *owner = o->getControllingPlayer();
+		if (!owner || (owner != &player && player.getRelationship(owner) != ALLIES) || o->isEffectivelyDead()) continue;
+		const auto *other = TerrainResourceClaimView::resourceDataOf(*o->getTemplate());
+		if (!other || other->m_maxIncome <= 0) continue;
+		const float dx = at.x-o->getPosition()->x, dy = at.y-o->getPosition()->y;
+		const float radius = data->m_radius+other->m_radius;
+		if (dx*dx+dy*dy < radius*radius) return 0;
+	}
+	return TerrainResourceClaimView::claimableFraction(logic,at.x,at.y,data->m_radius,data->m_highPriority,player.getPlayerIndex());
