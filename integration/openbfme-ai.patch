+bool enhancedSiegeAllowed(GameLogic &logic, const AISkirmishPlayer &ai)
+{
+	const Player *player = logic.players().getNthPlayer(ai.playerIndex);
+	if (!player || !logic.shroud()) return false;
+	int own = 0, enemies = 0, homeThreats = 0;
+	bool building = false;
+	Coord3D home{};
+	for (const Object *o = logic.getFirstObject(); o; o = o->getNextObject())
+	{
+		if (o->getControllingPlayer() != player || o->isEffectivelyDead() || o->getContainedBy()) continue;
+		if (o->isKindOfName("COMMANDCENTER")) home = *o->getPosition();
+		const int role = AIThreatFinder::threatCategory(*o->getTemplate());
+		if (!o->isKindOfName("STRUCTURE") && role >= 0 && role <= 3 && o->getTemplate()->getName() != "AngmarThrallMaster") ++own;
+	}
+	for (const Object *o = logic.getFirstObject(); o; o = o->getNextObject())
+	{
+		if (o->isEffectivelyDead() || o->getContainedBy() || !o->getControllingPlayer() || player->getRelationship(o->getControllingPlayer()) != ENEMIES ||
+			logic.shroud()->clientObjectStatus(*o, ai.playerIndex) >= 3 || InvisibilityManager::clientLook(*o, player) == 5) continue;
+		if (o->isKindOfName("STRUCTURE")) { building = true; continue; }
+		const int role = AIThreatFinder::threatCategory(*o->getTemplate());
+		if ((role >= 0 && role <= 3) || o->isKindOfName("HERO"))
+		{
+			const int power = o->isKindOfName("HERO") ? 2 : 1;
+			enemies += power;
+			const float dx = SimMath::subf32(o->getPosition()->x, home.x), dy = SimMath::subf32(o->getPosition()->y, home.y);
+			if (SimMath::addf32(SimMath::mulf32(dx, dx), SimMath::mulf32(dy, dy)) < 810000.0f) homeThreats += power;
+		}
+	}
+	return CounterProduction::siegeAllowed(own, enemies, homeThreats, building);
+}
