@@ -0,0 +1,18 @@
+// Opt-in OpenBFME mod rules, not retail recreation. Never applies to human players.
+#pragma once
+#include "Common/Player.h"
+#include "GameLogic/GameLogic.h"
+#include "GameLogic/SkirmishAI/SkirmishAIManager.h"
+#include "GameLogic/SkirmishAI/SkirmishAIData.h"
+
+namespace EnhancedStrategy
+{
+inline float multiplier(GameLogic &logic, const Player *player, bool income)
+{
+	if (!player || player->getPlayerType() != PLAYER_COMPUTER) return 1.0f;
+	const AISkirmishPlayer *ai = logic.skirmishAI().findAI(player->getPlayerIndex());
+	if (!ai || !ai->store->data().enhancedCounterProduction) return 1.0f;
+	const float value = income ? ai->store->data().enhancedIncomeMultiplier : ai->store->data().enhancedProductionMultiplier;
+	return value >= 1.0f && value <= 2.0f ? value : 1.0f;
+}
+}
