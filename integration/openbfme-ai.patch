+			const int category = unit ? AIThreatFinder::threatCategory(*unit) : -1;
+			if (!((category >= 0 && category <= 3) || member.unit == "AngmarThrallMaster")) continue;
+			const auto range = ai->build.units.factories.equal_range(ai->store->keyOf(member.unit));
+			for (auto factory = range.first; factory != range.second; ++factory) armyFactories.insert(factory->second);
+		}
+	static const std::vector<unsigned> combatBits = [] {
+		std::vector<unsigned> bits;
+		for (unsigned bit = 0; bit < 19 * 32 && TheModelConditionNames[bit]; ++bit)
+		{
+			const std::string name = TheModelConditionNames[bit];
+			for (const char *token : {"ATTACKING", "FIRING", "PREATTACK", "RELOADING", "USING_WEAPON"})
+				if (name.find(token) != std::string::npos) { bits.push_back(bit); break; }
+		}
+		return bits;
+	}();
+	const auto fighting = [&](const ::Object *unit) {
+		const auto &bits = unit->getModelConditionBits();
+		for (unsigned bit : combatBits) if ((bits[bit >> 5] >> (bit & 31)) & 1u) return true;
+		return false;
+	};
+	for (int i = 1; i < logic.players().getPlayerCount(); ++i)
+	{
+		Player *p = logic.players().getNthPlayer(i);
+		if (!p || !p->getPlayerTemplate() || !p->getPlayerTemplate()->m_playableSide || p->isObserver()) continue;
+		const auto relationship = observer->getRelationship(p);
+		const bool friendly = p == observer || relationship == ALLIES;
+		Dictionary rec;
+		rec["index"] = i;
+		if (friendly) if (const auto *record=logic.skirmishAI().record(i)) rec["farms_lost"]=(int64_t)record->farmsLost();
+		rec["faction"] = toGodot(p->getPlayerTemplate()->getName());
+		rec["relation"] = p == observer ? "self" : relationship == ALLIES ? "ally" : relationship == ENEMIES ? "enemy" : "neutral";
+		Array objects;
+		for (const ::Object *o = logic.getFirstObject(); o; o = o->getNextObject())
+		{
+			// Horde members and tunnel occupants never appear as separate snapshot objects.
+			// Exclude them before the more expensive allied visibility checks.
+			if (o->getControllingPlayer() != p || o->isEffectivelyDead() || o->isDestroyed() || o->getContainedBy()) continue;
+			if (!friendly)
+			{
+				bool visible = false;
+				for (int viewer = 1; viewer < logic.players().getPlayerCount(); ++viewer)
+				{
+					Player *ally = logic.players().getNthPlayer(viewer);
+					if (!ally || !ally->getPlayerTemplate() || !ally->getPlayerTemplate()->m_playableSide || ally->isObserver() || ally->isDefeated() || (ally != observer && observer->getRelationship(ally) != ALLIES)) continue;
+					if (m_game->shroud().clientObjectStatus(*o, viewer) < 3 && InvisibilityManager::clientLook(*o, ally) != 5) { visible = true; break; }
+				}
+				if (!visible) continue;
+			}
+			if (o->isKindOfName("DOZER"))
+			{
+				if (p == observer)
+				{
+					Dictionary builder;
+					builder["id"] = (int64_t)o->getID(); builder["x"] = o->getPosition()->x; builder["y"] = o->getPosition()->y;
+					const DozerAIUpdate *d = dynamic_cast<const DozerAIUpdate *>(o->getAIUpdateInterface());
+					builder["idle"] = d && d->getCurrentTask() == DozerAIUpdate::DOZER_TASK_INVALID && !d->isAnyTaskPending();
+					builder["moving"] = d && d->isMoving();
+					builders.push_back(builder);
+				}
+				continue;
+			}
+			const bool structure = o->isKindOfName("STRUCTURE");
+			if (!structure && !(o->isKindOfName("CAN_ATTACK") || o->isKindOfName("SUPPORT") || o->isKindOfName("HERO"))) continue;
+			Dictionary item;
+			item["id"] = (int64_t)o->getID();
+			item["template"] = toGodot(o->getTemplate()->getName());
+			item["owner_index"] = i;
+			item["structure"] = structure;
+			item["base"] = o->isKindOfName("COMMANDCENTER");
+			item["hero"] = o->isKindOfName("HERO");
+			item["armed"] = o->isKindOfName("CAN_ATTACK");
+			item["public_cost"] = BuildAssistant::calcCostToBuild(*o->getTemplate()->getFinalOverride(), nullptr, nullptr, -1); // public template price, never enemy money/discounts
+			if (p == observer) { item["own_cost"] = BuildAssistant::calcCostToBuild(*o->getTemplate()->getFinalOverride(), p, nullptr, -1); item["paid_cost"]=o->getBuildCostPaid(); }
+			item["economy"] = o->isKindOfName("ECONOMY_STRUCTURE");
+			item["builder"] = o->isKindOfName("DOZER");
+			item["mobile"] = o->getAIUpdateInterface()!=nullptr;
+			item["wall_hub"] = o->isKindOfName("WALL_HUB");
+			item["wall_segment"] = o->isKindOfName("WALL_SEGMENT");
+			if (p==observer) if (const auto *resource=dynamic_cast<const TerrainResourceBehavior *>(o->findModule("TerrainResourceBehavior"))) {
+				item["resource_share"]=resource->claimShare();
+				item["resource_radius"]=resource->data()->m_radius;
+				item["base_income_per_second"]=resource->data()->m_incomeInterval>0 ? resource->data()->m_maxIncome*resource->claimShare()*5.0/(double)resource->data()->m_incomeInterval : 0.0;
+			}
+			Array activity;
+			const ::Object::ModelConditionBits &conditionBits = o->getModelConditionBits();
+			for (int bit = 0; bit < 19 * 32 && TheModelConditionNames[bit]; ++bit)
+			{
+				if (!((conditionBits[(size_t)bit >> 5] >> (bit & 31)) & 1u)) continue;
+				const std::string name = TheModelConditionNames[bit];
+				if (name.find("SPECIAL") != std::string::npos || name.find("USING_ABILITY") != std::string::npos) activity.push_back(toGodot(name));
+			}
+			item["visible_activity"] = activity;
+			bool ownCombat = p == observer && !structure && fighting(o);
+			if (const BodyModuleInterface *body = o->getBodyModule())
+			{
+				item["health_ratio"] = body->getMaxHealth() > 0 ? body->getHealth() / body->getMaxHealth() : 1.0f;
+				if (p == observer) { item["health"] = body->getHealth(); item["max_health"] = body->getMaxHealth(); }
+			}
+			item["complete"] = !o->isUnderConstruction();
+			if (ContainModuleInterface *contain = o->getContain())
+			{
+				if (p == observer)
+					if (const HordeContain *horde = dynamic_cast<const HordeContain *>(contain)) ownCombat = ownCombat || horde->meleeEngaged();
+				if (const HordeContainInterface *horde = contain->getHordeContainInterface())
+				{
+					float health = 0.0f, maximum = 0.0f;
+					unsigned members = 0;
+					if (const auto *items = contain->getContainedItemsList())
+						for (const ::Object *member : *items)
+							if (member && !member->isEffectivelyDead() && member->getBodyModule())
+							{
+								health += member->getBodyModule()->getHealth();
+								maximum += member->getBodyModule()->getMaxHealth();
+								if (p == observer && !ownCombat) ownCombat = fighting(member);
+								++members;
+							}
+					const unsigned slots = std::max(1u, horde->getSlotCount());
+					item["member_count"] = (int64_t)members;
+					item["health_ratio"] = maximum > 0.0f ? (health / maximum) * std::min(1.0f, (float)members / (float)slots) : 0.0f;
+				}
+			}
+			if (p == observer && !structure)
+			{
+				item["ok"] = true;
+				item["combat_active"] = ownCombat;
+				item["moving"] = o->getAIUpdateInterface() && o->getAIUpdateInterface()->isMoving();
+				item["contained_by"] = (int64_t)0;
+			}
+			if (p == observer && structure)
+			{
+				item["army_factory"] = armyFactories.count(o->getID()) != 0;
+				if (const ProductionUpdateInterface *production = o->getProductionUpdate())
+				{
+					item["queue_count"] = (int64_t)production->getProductionCount();
+					item["factory_disabled"] = production->isFactoryDisabled();
+				}
+			}
+			item["tunnel"] = dynamic_cast<const TunnelContain *>(o->getContain()) != nullptr;
+			item["category"] = AIThreatFinder::threatCategory(*o->getTemplate());
+			item["x"] = o->getPosition()->x;
+			item["y"] = o->getPosition()->y;
+			objects.push_back(item);
+		}
+		rec["objects"] = objects;
+		players.push_back(rec);
+	}
+	out["players"] = players;
+	out["builders"] = builders;
+	Array production;
+	if (const AISkirmishPlayer *ai = logic.skirmishAI().findAI((int)playerIndex))
+	{
+		for (const auto &member : ai->army->members)
+		{
+			const auto it = ai->build.units.composition.find(ai->store->keyOf(member.unit));
+			if (it == ai->build.units.composition.end()) continue;
+			Dictionary row;
+			row["unit"] = toGodot(member.unit);
+			row["percent"] = it->second;
+			production.push_back(row);
+		}
+	}
+	out["production_plan"] = production;
+	if (const AISkirmishPlayer *ai = logic.skirmishAI().findAI((int)playerIndex))
+	{
+		out["hero_requests"] = (int64_t)ai->build.units.heroesMade;
+		out["upgrade_requests"] = (int64_t)ai->build.unitUpgrader.submitted;
+	}
+	return out;
+}
+
+Dictionary GameWorld::strategy_set_policy(int64_t playerIndex, const Dictionary &policy)
+{
+	Dictionary out; out["ok"] = false;
+	if (!m_game || m_netStarted || m_replayPlayback || m_saveLoad) return out;
+	m_game->drainFrames();
+	const auto context = m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic = m_game->logic();
+	Player *player = logic.players().getNthPlayer((int)playerIndex);
+	AISkirmishPlayer *ai = logic.skirmishAI().findAI((int)playerIndex);
+	if (!player || player->getPlayerType() != PLAYER_COMPUTER || !ai || !ai->store->data().enhancedCounterProduction) return out;
+	Array weights = policy.get("weights", Array());
+	if (weights.size() != 4) return out;
+	for (int i = 0; i < 4; ++i)
+	{
+		const double value = weights[i];
+		if (!std::isfinite(value) || value < 0.25 || value > 4.0) return out;
+	}
+	const double economy = policy.get("economy_priority", 1.0);
+	if (!std::isfinite(economy) || economy < 0.5 || economy > 2.0) return out;
+	const double tech = policy.get("tech_priority", 1.0);
+	if (!std::isfinite(tech) || tech < 0.5 || tech > 2.0) return out;
+	for (int i = 0; i < 4; ++i) ai->build.units.strategyWeights[i] = (float)(double)weights[i];
+	ai->build.units.strategyEconomyPriority = (float)economy;
+	ai->build.units.strategyTechPriority = (float)tech;
+	ai->build.units.strategyCanExpand = (bool)policy.get("expand", true);
+	ai->build.units.strategyEmergency = (bool)policy.get("emergency", false);
+	ai->build.units.strategyUntil = (int)logic.getFrame() + 150;
+	out["ok"] = true;
+	return out;
+}
+
+Dictionary GameWorld::strategy_build_forward(int64_t playerIndex, int64_t builderId, double x, double y)
+{
+	if (!m_game || m_netStarted || m_replayPlayback || m_saveLoad) return Dictionary();
+	m_game->drainFrames();
+	const auto context = m_world ? m_world->enterContext() : nullptr;
+	const Player *player = m_game->logic().players().getNthPlayer((int)playerIndex);
+	const std::string faction = player && player->getPlayerTemplate() ? player->getPlayerTemplate()->getName() : "";
+	return strategy_construct(playerIndex, builderId, toGodot(faction == "FactionDwarves" ? "DwarvenMineShaft" : faction == "FactionWild" ? "WildMineShaft" : ""), x, y);
+}
