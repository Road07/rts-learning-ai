+namespace
+{
+bool strategyStandaloneWall(GameLogic &logic, const ThingTemplate &tt)
+{
+	const auto &kind = logic.templateInfo(tt.getFinalOverride()).kindOf;
+	for (const char *name : {"WALL_HUB", "WALL_SEGMENT"})
+	{
+		const int bit = ObjectTemplateInfoBuilder::kindOfIndex(name);
+		if (bit >= 0 && MaskTest(kind, (unsigned)bit)) return true;
+	}
+	return false;
+}
