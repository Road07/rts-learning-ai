+	else if (!u.classicDone && completeFarms<2) u.classicStage=1;
+	else if (!producer) { u.classicStage=2; build=choice->producer; }
+	else if (!u.classicDone && producer->isUnderConstruction()) { u.classicStage=2; unfinished=producer; }
+	else if (!u.classicFirstSword)
