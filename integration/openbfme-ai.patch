+bool classicOpeningUpdate(GameLogic &logic, AISkirmishPlayer &ai, Player &player)
+{
+	if (!ai.store->data().classicOpening || !ai.army || player.getPlayerType()!=PLAYER_COMPUTER) return false;
+	struct Choice { const char *faction, *producer, *sword, *recruit; };
+	static const Choice choices[] = {
+		{"FactionMen","GondorBarracks","GondorFighterHorde","GondorFighterHorde"},
+		{"FactionElves","ElvenBarracks","ElvenLorienWarriorHorde","ElvenLorienWarriorHorde"},
+		{"FactionDwarves","DwarfBarracks","DwarvenGuardianHorde","DwarvenGuardianHorde"},
+		{"FactionWild","GoblinCave","GoblinFighterHorde","GoblinFighterHorde"},
+		{"FactionMordor","MordorOrcPit","MordorFighterHorde","MordorFighterHorde"},
+		{"FactionIsengard","IsengardUrukPit","IsengardFighterHorde","IsengardFighterHorde"},
+		{"FactionAngmar","AngmarBarracks","AngmarOrcWarriors","AngmarThrallMaster"}};
+	const Choice *choice = nullptr;
+	for (const auto &entry : choices) if (player.getPlayerTemplate()->getName()==entry.faction) { choice=&entry; break; }
+	if (!choice) return false;
+	auto &u = ai.build.units;
+	Object *producer = nullptr, *unfinished = nullptr, *thrall = nullptr;
+	int farms=0, completeFarms=0;
+	std::vector<Object *> builders;
+	for (Object *o=logic.getFirstObject();o;o=o->getNextObject())
+	{
+		if (o->getControllingPlayer()!=&player || o->isEffectivelyDead() || o->isDestroyed()) continue;
+		const auto &name=o->getTemplate()->getName();
+		if (name==ai.army->economyTemplate) { ++farms; if (!o->isUnderConstruction()) ++completeFarms; }
+		if (name==choice->producer) { producer=o; u.classicProducerStarted=true; }
+		if (name==choice->sword && !o->isUnderConstruction()) u.classicFirstSword=true;
