+Dictionary GameWorld::strategy_training_control(int64_t playerIndex, int64_t frames)
+{
+	Dictionary out; out["ok"]=false;
+	if (!m_game || !m_testHooks || m_netHost || m_netClient || m_netStarted || m_netSession || m_replayPlayback || m_saveLoad || frames<0 || frames>150) return out;
+	m_game->drainFrames();
+	const auto context = m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic=m_game->logic();
+	Player *p=logic.players().getNthPlayer((int)playerIndex);
+	AISkirmishPlayer *ai=logic.skirmishAI().findAI((int)playerIndex);
+	if (!p || p->getPlayerType()!=PLAYER_COMPUTER || !ai || !ai->store->data().enhancedCounterProduction) return out;
+	ai->build.units.trainingControlUntil=frames ? (int)logic.getFrame()+(int)frames : 0;
+	out["ok"]=true; return out;
+}
+
+Dictionary GameWorld::strategy_reward_observation(int64_t playerIndex, int64_t afterIncome)
+{
+	Dictionary out; out["ok"]=false;
+	if (!m_game || m_netHost || m_netClient || m_netStarted || m_netSession || m_replayPlayback || m_saveLoad) return out;
+	m_game->drainFrames(); const auto context=m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic=m_game->logic(); Player *p=logic.players().getNthPlayer((int)playerIndex);
+	if (!p || p->getPlayerType()!=PLAYER_COMPUTER || !p->getPlayerTemplate() || !p->getPlayerTemplate()->m_playableSide) return out;
+	const ScoreKeeper &score=p->getScoreKeeper();
+	int units=0,structures=0;
+	for (int i=1;i<logic.players().getPlayerCount();++i)
+	{
+		const Player *other=logic.players().getNthPlayer(i);
+		if (other && p->getRelationship(other)==ENEMIES) { units+=score.unitsDestroyed(i); structures+=score.structuresDestroyed(i); }
+	}
+	out["player"]=playerIndex; out["frame"]=(int64_t)logic.getFrame();
+	out["enemy_units"]=units; out["enemy_structures"]=structures;
+	out["own_units_lost"]=score.unitsLost(); out["own_structures_lost"]=score.structuresLost();
+	const auto &events=logic.economy().incomeLog();
+	const int64_t cursor=(int64_t)logic.economy().incomePayments();
+	const int64_t first=cursor-(int64_t)events.size()+1;
+	int64_t income=0,serial=cursor;
+	Array payments;
+	if (afterIncome>=0)
+		for (auto it=events.rbegin();it!=events.rend() && serial>afterIncome;++it,--serial)
+			if (it->playerIndex==(int)playerIndex) {
+				income+=it->amount;
+				Dictionary payment; payment["serial"]=serial; payment["object"]=(int64_t)it->object;
+				payment["frame"]=(int64_t)it->frame; payment["amount"]=it->amount; payments.push_back(payment);
+			}
+	out["income_delta"]=income; out["income_cursor"]=cursor;
+	out["income_payments"]=payments;
+	out["income_complete"]=afterIncome<0 || (afterIncome<=cursor && afterIncome>=first-1);
+	Array dead;
+	for (const HeroRecord &hero:p->heroes().records()) if (hero.dead) dead.push_back(toGodot(hero.templateName));
+	out["dead_heroes"]=dead;
+	const VictoryConditions &victory=static_cast<const GameLogic &>(logic).victory();
+	out["won"]=victory.hasAchievedVictory(p); out["defeated"]=p->isDefeated();
+	bool teamDefeated=true;
+	for (int i=1;i<logic.players().getPlayerCount();++i)
+	{
+		const Player *ally=logic.players().getNthPlayer(i);
+		if (ally && ally->getPlayerTemplate() && ally->getPlayerTemplate()->m_playableSide && !ally->isObserver() && (ally==p || p->getRelationship(ally)==ALLIES) && !ally->isDefeated()) teamDefeated=false;
+	}
+	out["team_defeated"]=teamDefeated;
+	out["ok"]=true; return out;
+}
+
+Array GameWorld::strategy_model_options(int64_t playerIndex, bool full, const String &requestedId)
+{
+	Array empty;
+	if (!m_game || m_netHost || m_netClient || m_netStarted || m_netSession || m_replayPlayback || m_saveLoad) return empty;
+	m_game->drainFrames();
+	const auto context=m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic=m_game->logic();
+	Player *p=logic.players().getNthPlayer((int)playerIndex);
+	AISkirmishPlayer *ai=logic.skirmishAI().findAI((int)playerIndex);
+	if (!p || !ai || !ai->build.units.modelOnlyControl || !TheCommandStore) return empty;
+	const bool one=!requestedId.is_empty();
+	const std::string wantedKind=one ? toNative(requestedId.get_slice(":",0)) : "";
+	const int64_t wantedSource=one ? requestedId.get_slice(":",1).to_int() : 0;
+	const int64_t wantedTarget=one ? requestedId.get_slice(":",3).to_int() : 0;
+	const Dictionary observation=strategy_observation(playerIndex);
+	std::vector<::Object *> owned, friendly, enemies;
+	Array players=observation.get("players",Array());
+	for (int i=0;i<players.size();++i)
+	{
+		Dictionary row=players[i]; const String relation=row.get("relation",""); Array objects=row.get("objects",Array());
+		for (int j=0;j<objects.size();++j)
+		{
+			Dictionary object=objects[j]; ::Object *o=logic.findObjectByID((::ObjectID)(int64_t)object["id"]);
+			if (!o || o->isEffectivelyDead() || o->isDestroyed()) continue;
+			if (relation=="self") owned.push_back(o);
+			if (relation=="self" || relation=="ally") friendly.push_back(o);
+			if (relation=="enemy") enemies.push_back(o); // already fog + stealth filtered
+		}
+	}
+	std::map<std::string,std::vector<Dictionary>> buckets;
+	std::unordered_set<std::string> seen;
+	const ::Object *home=nullptr;
+	for (::Object *o:owned) if (o->isKindOfName("COMMANDCENTER")) { home=o; break; }
+	auto add=[&](const std::string &kind, ::Object *source, const std::string &name, int64_t target, int variant, int cost) -> Dictionary
+	{
+		Dictionary op;
+		const std::string id=kind+":"+std::to_string(source ? source->getID() : 0)+":"+name+":"+std::to_string(target)+":"+std::to_string(variant);
+		if (one && toGodot(id)!=requestedId) return op;
+		if (!seen.insert(id).second) return op;
+		op["id"]=toGodot(id); op["kind"]=toGodot(kind); op["template"]=toGodot(name);
+		op["producer"]=(int64_t)(source ? source->getID() : 0); op["target"]=target; op["variant"]=variant; op["cost"]=cost;
+		op["source_health"]=source && source->getBodyModule() && source->getBodyModule()->getMaxHealth()>0 ? source->getBodyModule()->getHealth()/source->getBodyModule()->getMaxHealth() : 1.0f;
+		op["source_hero"]=source && source->isKindOfName("HERO");
+		op["source_role"]=source ? AIThreatFinder::threatCategory(*source->getTemplate()) : -1;
+		op["source_contained"]=source && source->getContainedBy();
+		auto distance=[](const ::Object *a,const ::Object *b) { if (!a || !b) return 0.0f; const float x=a->getPosition()->x-b->getPosition()->x,y=a->getPosition()->y-b->getPosition()->y; return std::sqrt(x*x+y*y); };
+		const ::Object *to=target>0 ? logic.findObjectByID((::ObjectID)target) : nullptr;
+		op["source_distance_home"]=distance(source,home); op["target_distance"]=distance(source,to);
+		op["target_hero"]=to && to->isKindOfName("HERO"); op["target_structure"]=to && to->isKindOfName("STRUCTURE");
+		if (to && to->getControllingPlayer()) op["target_relation"]=to->getControllingPlayer()==p ? "self" : p->getRelationship(to->getControllingPlayer())==ALLIES ? "ally" : "enemy";
+		buckets[kind].push_back(op); return op;
+	};
+	const Array purchases=one ? Array() : strategy_production_options(playerIndex);
+	for (int i=0;i<purchases.size();++i) { Dictionary op=purchases[i]; buckets[toNative(String(op["kind"]))].push_back(op); }
+	const PlayerTemplate *pt=p->getPlayerTemplate();
+	// Science buttons come from this player's real purchase command set, not a global list.
+	const std::string scienceName=logic.players().templates().purchaseScienceCommandSetFor(*p,TheCommandStore);
+	if (!one || wantedKind=="science") if (const CommandSet *set=TheCommandStore->findCommandSet(scienceName))
+		for (int slot=0;slot<CommandSet::slotCapacity();++slot)
+			if (const CommandButton *b=set->getCommandButton(slot))
+				for (const std::string &name:b->m_science)
+				{
+					const ScienceType science=TheScienceStore ? TheScienceStore->getScienceFromInternalName(name) : SCIENCE_INVALID;
+					if (p->science().isCapableOfPurchasingScience(science) && !p->isScienceDisabled(science) && !p->isScienceHidden(science))
+					{
+						Dictionary op=add("science",nullptr,name,0,0,0);
+						if (!op.is_empty()) buckets["science"].back()["points_cost"]=TheScienceStore->getSciencePurchaseCost(science,p->science().mode().skirmishOrMultiplayer);
+					}
+				}
+	::Object *book=SpecialPowerModules::findSpellBookObject(logic,*p);
+	if (book && std::find(owned.begin(),owned.end(),book)==owned.end()) owned.push_back(book);
+	for (::Object *o:owned)
+	{
+		if (one && (int64_t)o->getID()!=wantedSource) continue;
+		if (o->getControllingPlayer()!=p || o->isUnderConstruction()) continue;
+		const ProductionUpdateInterface *production=o->getProductionUpdate();
+		if ((!one || wantedKind=="wall") && o->isKindOfName("WALL_HUB")) {
+			if (const CommandSet *wallSet=TheCommandStore->findCommandSet(o->getCommandSetName()))
+			for (int slot=0;slot<CommandSet::slotCapacity();++slot) {
+				const CommandButton *button=wallSet->getCommandButton(slot);
+				if (!button || button->m_command!=GUI_COMMAND_DOZER_CONSTRUCT) continue;
+				WallHubBehavior *hub=WallHubBehavior::find(*o,button->m_options);
+				if (!hub || !hub->hubCapTemplate()) continue;
+				bool cpShort=false;
+				const auto availability=ControlBar::evaluateForObject(logic,*button,*o,cpShort);
+				if (availability!=ButtonState::Enabled && availability!=ButtonState::Active) continue;
+				for (int direction=0;direction<8;++direction) for (int length=0;length<2;++length) {
+					const int variant=slot*16+direction*2+length;
+					if (one && variant!=requestedId.get_slice(":",4).to_int()) continue;
+					const float angle=direction*0.785398163f, distance=length==0 ? 180.0f : 320.0f;
+					const Coord3D start=*o->getPosition();
+					Coord3D end{start.x+distance*std::cos(angle),start.y+distance*std::sin(angle),0}; end.z=logic.getGroundHeight(end.x,end.y);
+					WallSpan::Plan plan;
+					const bool planned=WallSpan::plan(logic,*o,start,end,button->m_options,plan);
+					if (!planned || plan.worstCode!=0 || plan.cost<=0) continue;
+					bool clear=true; for (const auto &tile:plan.tiles) if (m_game->shroud().getStatusAt((int)playerIndex,tile.pos.x,tile.pos.y)!=0) { clear=false; break; }
+					if (!clear || plan.cost>(int)p->getMoney()->countMoney()) continue;
+					Dictionary op=add("wall",o,hub->hubCapTemplate()->getName(),0,variant,plan.cost);
+					if (op.is_empty()) continue;
+					auto &stored=buckets["wall"].back(); stored["x"]=end.x; stored["y"]=end.y;
+					stored["start_x"]=start.x; stored["start_y"]=start.y; stored["wall_options"]=(int64_t)button->m_options;
+					stored["connected_wall"]=true; stored["wall_length"]=distance; stored["wall_tiles"]=(int)plan.tiles.size();
+				}
+			}
+		}
+		if (production)
+		{
+			for (const ProductionEntry *e=production->firstProduction();e;e=production->nextProduction(e))
+			{
+				std::string name=e->upgradeToResearch ? e->upgradeToResearch->getUpgradeName() : e->objectToProduce ? e->objectToProduce->getName() : "";
+				const auto *concrete=dynamic_cast<const ProductionUpdate *>(production);
+				if (e->percentComplete>=100.0f && concrete && concrete->exitingObjectID()!=INVALID_ID) continue;
+				Dictionary cancel=add("cancel",o,name,0,(int)e->productionID,0);
+				if (!cancel.is_empty()) {
+					auto &stored=buckets["cancel"].back();stored["queue_verified"]=true;
+					stored["queue_receipt_id"]=(int64_t)e->observationQueueID;
+					stored["queue_kind"]=e->type==PRODUCTION_UPGRADE ? "research" : "unit";
+					stored["queue_progress"]=e->percentComplete/100.0;stored["queue_work_seconds"]=e->framesUnderConstruction/5.0;
+					stored["queue_paid_cost"]=e->cost;stored["queue_remaining"]=e->quantityRemaining();
+				}
+			}
+			if (production->getProductionCount()==0 && !production->isFactoryDisabled())
+				for (int index=0;index<(int)p->heroes().size();++index)
+				{
+					const ThingTemplate *tt=p->heroes().templateAt(logic,index);
+					if (!tt || !pt || std::find(pt->m_buildableRingHeroesMP.begin(),pt->m_buildableRingHeroesMP.end(),tt->getName())!=pt->m_buildableRingHeroesMP.end()) continue;
+					const int custom=ObjectTemplateInfoBuilder::kindOfIndex("CREATE_A_HERO");
+					if (custom>=0 && MaskTest(logic.templateInfo(tt->getFinalOverride()).kindOf,(unsigned)custom)) continue;
+					if (!BuildAssistant::isInProducersCommandSet(*o,tt,index) || BuildAssistant::canMakeUnit(*o,tt,index)!=CANMAKE_OK) continue;
+					Dictionary op=add("hero",o,tt->getName(),0,index,p->heroes().costAt(logic,*p,index,o));
+					if (!op.is_empty()) buckets["hero"].back()["reviving"]=p->heroes().at(index)->dead;
+				}
+		}
+		if (o->getAIUpdateInterface() && !o->isKindOfName("STRUCTURE"))
+		{
+			add("stop",o,o->getTemplate()->getName(),0,0,0);
+			if (o->findModule("StancesBehavior")) for (int stance:{1,2,3}) add("stance",o,o->getTemplate()->getName(),0,stance,0);
+			if (!o->getContainedBy())
+				for (::Object *container:friendly)
+					if (container!=o && container->getContain() && !container->isUnderConstruction() &&
+						(dynamic_cast<TunnelContain *>(container->getContain()) || container->getContain()->isGarrisonable()) && container->getContain()->isValidContainerFor(*o,true,false))
+						add("enter",o,container->getTemplate()->getName(),container->getID(),0,0);
+		}
+		if (o->getContain() && (dynamic_cast<TunnelContain *>(o->getContain()) || o->getContain()->isGarrisonable()) && o->getContain()->getContainCount()>0)
+			add("exit",o,o->getTemplate()->getName(),0,0,0);
+		const CommandSet *set=TheCommandStore->findCommandSet(o->getCommandSetName());
+		if (!set) continue;
+		for (int slot=0;slot<CommandSet::slotCapacity();++slot)
+		{
+			const CommandButton *b=set->getCommandButton(slot);
+			if (!b) continue;
+			const bool bookPower=o==book && !b->m_specialPowerName.empty(); // SpellBookUI reads these independently of GUI command number / ShowButton.
+			if (one && wantedKind=="power" && b->m_specialPowerName!=toNative(requestedId.get_slice(":",2))) continue;
+			if (!bookPower && b->m_command!=GUI_COMMAND_PLAYER_UPGRADE && b->m_command!=GUI_COMMAND_OBJECT_UPGRADE && b->m_command!=GUI_COMMAND_CASTLE_UPGRADE && b->m_command!=GUI_COMMAND_HORDE_TOGGLE_FORMATION && b->m_command!=GUI_COMMAND_SPECIAL_POWER && b->m_command!=GUI_COMMAND_SPECIAL_POWER_TOGGLE) continue;
+			bool cpShort=false;
+			const ButtonState state=ControlBar::evaluateForObject(logic,*b,*o,cpShort);
+			if (!bookPower && state!=ButtonState::Enabled && state!=ButtonState::Active) continue;
+			if (b->m_command==GUI_COMMAND_PLAYER_UPGRADE || b->m_command==GUI_COMMAND_OBJECT_UPGRADE || b->m_command==GUI_COMMAND_CASTLE_UPGRADE)
+			{
+				const UpgradeTemplate *u=TheUpgradeCenter ? TheUpgradeCenter->findUpgrade(b->m_upgradeName) : nullptr;
+				if (b->m_upgradeName=="Upgrade_ThrallMasterRhudaurSlingers" && !AIBaseBuilder::modelRoleAllowed(logic,(int)playerIndex,1)) continue;
+				if (b->m_upgradeName=="Upgrade_ThrallMasterWolfRiders" && !AIBaseBuilder::modelRoleAllowed(logic,(int)playerIndex,3)) continue;
+				if (u && production && production->getProductionCount()==0)
+					add("research",o,b->m_upgradeName,0,0,u->calcCostToBuild(p,o));
+			}
+			if (b->m_command==GUI_COMMAND_HORDE_TOGGLE_FORMATION)
+				if (auto *horde=dynamic_cast<HordeContain *>(o->getContain()))
+					if (horde->canToggleFormation()) add("formation",o,b->m_name,0,0,0);
+			if (!bookPower && b->m_command!=GUI_COMMAND_SPECIAL_POWER && b->m_command!=GUI_COMMAND_SPECIAL_POWER_TOGGLE) continue;
+			const SpecialPowerTemplate *power=TheSpecialPowerStore ? TheSpecialPowerStore->findSpecialPowerTemplate(b->m_specialPowerName) : nullptr;
+			SpecialPowerModuleInterface *module=power ? SpecialPowerModules::findModule(*o,power) : nullptr;
+			if (!module || !module->requirementsMet() || !module->isReadyForDisplay() || !SpecialPowerModules::canUseSpecialPower(*o,power)) continue;
+			const bool pos=b->hasOption(COMMAND_OPTION_NEED_TARGET_POS);
+			const bool objectTarget=(b->m_options & 7u)!=0;
+			if (!pos && !objectTarget && ActionManager::canDoSpecialPower(*o,power)) add("power",o,b->m_specialPowerName,0,0,0);
+			else
+			{
+				std::vector<::Object *> targets;
+				if (pos || b->hasOption(COMMAND_OPTION_NEED_TARGET_ALLY_OBJECT)) targets.insert(targets.end(),friendly.begin(),friendly.end());
+				if (pos || b->hasOption(COMMAND_OPTION_NEED_TARGET_ENEMY_OBJECT)) targets.insert(targets.end(),enemies.begin(),enemies.end());
+				const size_t start=targets.empty() ? 0 : (size_t)(logic.getFrame()/25)%targets.size();
+				for (size_t at=0;at<targets.size();++at)
+				{
+					if (!full && at>=8) break; // bounded preview, rotated over future decisions
+					::Object *target=targets[(start+at)%targets.size()];
+					if (one && (int64_t)target->getID()!=wantedTarget) continue;
+					if (pos && !ActionManager::canDoSpecialPowerAtLocation(*o,*b,*target->getPosition())) continue;
+					Dictionary op=add("power",o,b->m_specialPowerName,target->getID(),pos ? 1 : 0,0);
+					if (op.is_empty()) continue;
+					auto &stored=buckets["power"].back(); stored["x"]=target->getPosition()->x; stored["y"]=target->getPosition()->y;
+					stored["needs_position"]=pos;
+					stored["target_health"]=target->getBodyModule() && target->getBodyModule()->getMaxHealth()>0 ? target->getBodyModule()->getHealth()/target->getBodyModule()->getMaxHealth() : 1.0f;
+				}
+			}
+		}
+	}
+	Array out;
+	// Interleave families and rotate within each: upgrades/powers cannot starve behind buildings.
+	const size_t offset=full ? 0 : (size_t)(logic.getFrame()/25);
+	for (size_t i=0;;++i)
+	{
+		bool appended=false;
+		for (auto &pair:buckets)
+		{
+			auto &items=pair.second; if (i>=items.size()) continue;
+			out.push_back(items[(i+offset)%items.size()]); appended=true;
+			if (!full && out.size()>=64) return out;
+		}
+		if (!appended) break;
+	}
+	return out;
+}
+
+Dictionary GameWorld::strategy_model_action(int64_t playerIndex, const Dictionary &operation)
+{
+	Dictionary result; result["ok"]=false;
+	if (!m_game || m_netHost || m_netClient || m_netStarted || m_netSession || m_replayPlayback || m_saveLoad) return result;
+	m_game->drainFrames();
+	{
+		const auto context=m_world ? m_world->enterContext() : nullptr;
+		const auto *ai=m_game->logic().skirmishAI().findAI((int)playerIndex);
+		if (!ai || !ai->build.units.modelOnlyControl) return result;
+	}
+	const String id=operation.get("id","");
+	if (id.begins_with("build:") || id.begins_with("train:")) return strategy_produce(playerIndex,operation);
+	Dictionary chosen;
+	const Array legal=strategy_model_options(playerIndex,true,id);
+	for (int i=0;i<legal.size();++i) { Dictionary op=legal[i]; if (String(op["id"])==id) { chosen=op; break; } }
+	if (chosen.is_empty()) { result["reason"]="command_no_longer_legal"; return result; }
+	const String kind=chosen["kind"], name=chosen["template"];
+	const int64_t source=chosen.get("producer",0), target=chosen.get("target",0), variant=chosen.get("variant",0);
+	if (kind=="build" || kind=="train") return strategy_produce(playerIndex,chosen);
+	if (kind=="hero") { queue_hero(playerIndex,source,variant); result["ok"]=true; }
+	else if (kind=="research") { queue_upgrade(playerIndex,source,name); result["ok"]=true; }
+	else if (kind=="science") result["ok"]=purchase_science(playerIndex,name);
+	else if (kind=="power") result["ok"]=variant==1 ? cast_object_power_at(playerIndex,source,name,(double)chosen["x"],(double)chosen["y"]) : cast_object_power(playerIndex,source,name,target);
+	else if (kind=="wall") result["ok"]=build2_wall_span(source,name,(double)chosen["start_x"],(double)chosen["start_y"],(double)chosen["x"],(double)chosen["y"],(int64_t)chosen["wall_options"]);
+	else if (kind=="enter") { Array ids; ids.push_back(source); result=order_garrison(ids,target); }
+	else if (kind=="exit") result=order_evacuate(source);
+	else if (kind=="formation") result=order_toggle_formation(source);
+	else if (kind=="stop") { Array ids; ids.push_back(source); result=order_stop(ids); }
+	else
+	{
+		m_game->drainFrames(); const auto context=m_world ? m_world->enterContext() : nullptr;
+		GameLogic &logic=m_game->logic();
+		::Object *o=logic.findObjectByID((::ObjectID)source);
+		if (!o) return result;
+		if (kind=="stance")
+		{
+			GameMessage select(MSG_CREATE_SELECTED_GROUP,(int)playerIndex); select.appendBooleanArgument(true); select.appendObjectIDArgument(o->getID()); m_game->commands().append(select);
+			GameMessage message(MSG_CHANGE_STANCE,(int)playerIndex); message.appendIntegerArgument((int)variant); m_game->commands().append(message); result["ok"]=true;
+		}
+		else if (kind=="cancel")
+		{
+			const auto *production=o->getProductionUpdate();
+			for (const ProductionEntry *e=production ? production->firstProduction() : nullptr;e;e=production->nextProduction(e))
+			{
+				if ((int64_t)e->productionID!=variant) continue;
+				if (e->type==PRODUCTION_UPGRADE && e->upgradeToResearch)
+				{
+					GameMessage select(MSG_CREATE_SELECTED_GROUP,(int)playerIndex); select.appendBooleanArgument(true); select.appendObjectIDArgument(o->getID()); m_game->commands().append(select);
+					GameMessage message(MSG_CANCEL_UPGRADE,(int)playerIndex); message.appendIntegerArgument(e->upgradeToResearch->getMaskBit()); m_game->commands().append(message);
+				}
+				else if (e->type==PRODUCTION_BUILD_INDEX)
+				{
+					const Player *p=o->getControllingPlayer(); const HeroRecord *record=p ? p->heroes().findByProductionID(e->productionID) : nullptr;
+					if (!record || !e->objectToProduce) return result;
+					const int index=p->heroes().findIndex(*e->objectToProduce,e->productionID,0); if (index<0) return result;
+					cancel_hero(playerIndex,source,index);
+				}
+				else cancel_unit(playerIndex,source,name,false);
+				result["ok"]=true; break;
+			}
+		}
+	}
+	result["operation"]=chosen; result["status"]="submitted";
+	return result;
+}
+
+Dictionary GameWorld::strategy_model_control(int64_t playerIndex, bool enabled)
+{
+	Dictionary out; out["ok"]=false;
+	if (!m_game || m_netHost || m_netClient || m_netStarted || m_netSession || m_replayPlayback || m_saveLoad) return out;
+	m_game->drainFrames();
+	const auto context=m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic=m_game->logic();
+	Player *p=logic.players().getNthPlayer((int)playerIndex);
+	AISkirmishPlayer *ai=logic.skirmishAI().findAI((int)playerIndex);
+	if (!p || p->getPlayerType()!=PLAYER_COMPUTER || !ai || !ai->store->data().enhancedCounterProduction) return out;
+	ai->build.units.modelOnlyControl=enabled;
+	out["ok"]=true; return out;
+}
+
+Array GameWorld::strategy_production_options(int64_t playerIndex, bool trainingOnly)
+{
+	Array out;
+	if (!m_game || m_netStarted || m_replayPlayback || m_saveLoad) return out;
+	m_game->drainFrames();
+	const auto worldContext = m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic = m_game->logic();
+	Player *p = logic.players().getNthPlayer((int)playerIndex);
+	const AISkirmishPlayer *ai = logic.skirmishAI().findAI((int)playerIndex);
+	if (!p || p->getPlayerType() != PLAYER_COMPUTER || !ai || !ai->store->data().enhancedCounterProduction || !TheCommandStore || (int)logic.getFrame() < ai->build.units.strategySpendUntil) return out;
+	std::unordered_set<std::string> offered;
+	const bool siegeAllowed = AIBaseBuilder::modelSiegeAllowed(logic, *ai);
+	const bool controlled = ai->build.units.modelOnlyControl || (int)logic.getFrame() < ai->build.units.trainingControlUntil;
+	const bool modelOnly=ai->build.units.modelOnlyControl;
+	std::vector<const ::Object *> friendlyFarms;
+	const ::Object *home=nullptr;
+	bool hasWallHub=false;
+	Array visibleEnemies;
+	if (modelOnly) {
+		const Dictionary observation=strategy_observation(playerIndex);
+		Array players=observation.get("players",Array());
+		for (int i=0;i<players.size();++i) { Dictionary row=players[i]; if (String(row.get("relation",""))=="enemy") { Array objects=row.get("objects",Array()); for (int j=0;j<objects.size();++j) visibleEnemies.push_back(objects[j]); } }
+		for (::Object *object=logic.getFirstObject();object;object=object->getNextObject()) {
+			if (object->isEffectivelyDead() || object->isDestroyed()) continue;
+			const Player *owner=object->getControllingPlayer();
+			if (owner==p) { if (object->isKindOfName("COMMANDCENTER") && !home) home=object; if (WallHubBehavior::find(*object,0)) hasWallHub=true; }
+			if (!owner || (owner!=p && p->getRelationship(owner)!=ALLIES)) continue;
+			const auto *resource=TerrainResourceClaimView::resourceDataOf(*object->getTemplate());
+			if (resource && resource->m_maxIncome>0) friendlyFarms.push_back(object);
+		}
+	}
+	for (::Object *o = logic.getFirstObject(); o; o = o->getNextObject())
+	{
+		if (o->getControllingPlayer() != p || o->isEffectivelyDead() || o->isDestroyed() || o->isUnderConstruction()) continue;
+		DozerAIUpdate *dozer = dynamic_cast<DozerAIUpdate *>(o->getAIUpdateInterface());
+		const bool builder = !trainingOnly && dozer && o->isKindOfName("DOZER") && dozer->getCurrentTask() == DozerAIUpdate::DOZER_TASK_INVALID && !dozer->isAnyTaskPending() && !dozer->isMoving();
+		if (builder && ai->store->data().classicOpening && !ai->build.units.classicDone && !controlled) continue;
+		const ProductionUpdateInterface *production = o->getProductionUpdate();
+		if (!builder && (!production || production->isFactoryDisabled() || production->getProductionCount() != 0)) continue;
+		const CommandSet *set = TheCommandStore->findCommandSet(o->getCommandSetName());
+		if (!set) continue;
+		for (int slot = 0; slot < CommandSet::slotCapacity(); ++slot)
+		{
+			const CommandButton *button = set->getCommandButton(slot);
+			if (!button || button->m_command != (builder ? GUI_COMMAND_DOZER_CONSTRUCT : GUI_COMMAND_UNIT_BUILD)) continue;
+			const ThingTemplate *tt = button->getThingTemplate();
+			if (!tt || !BuildAssistant::isInProducersCommandSet(*o, tt, -1) || BuildAssistant::canMakeUnit(*o, tt, -1) != CANMAKE_OK) continue;
+			// The legacy planner cannot connect walls; model-only choices use normal game legality.
+			const bool wall=builder && strategyStandaloneWall(logic,*tt);
+			if (wall && (!modelOnly || hasWallHub)) continue;
+			const int heroBit = ObjectTemplateInfoBuilder::kindOfIndex("HERO");
+			const int dozerBit = ObjectTemplateInfoBuilder::kindOfIndex("DOZER");
+			const auto &kind = logic.templateInfo(tt->getFinalOverride()).kindOf;
+			if (!builder && ((heroBit >= 0 && MaskTest(kind, (unsigned)heroBit)) || (!controlled && dozerBit >= 0 && MaskTest(kind, (unsigned)dozerBit)))) continue;
+			if ((trainingOnly || controlled) && !builder && !AIBaseBuilder::modelRoleAllowed(logic,(int)playerIndex,AIThreatFinder::threatCategory(*tt))) continue;
+			const std::string name = tt->getName();
+			if (!trainingOnly && !modelOnly && offered.count(name)) continue;
+			// Only the legacy planner imposes a strategic siege restriction.
+			if (!builder && AIThreatFinder::threatCategory(*tt) == 7 && !siegeAllowed) continue;
+			Dictionary op;
+			op["kind"] = builder ? "build" : "train"; op["producer"] = (int64_t)o->getID(); op["template"] = toGodot(name);
+			op["cost"] = BuildAssistant::calcCostToBuild(*tt, p, o, -1);
+			op["cp_cost"]=std::max(0,BuildAssistant::commandPoints(*tt));
+			op["build_seconds"]=BuildAssistant::calcTimeToBuild(*tt,p,o,-1,logic.productionSettings(),logic)/5.0;
+			if (controlled) { op["role"]=AIThreatFinder::threatCategory(*tt); op["economy"]=tt->getName()==ai->army->economyTemplate; }
+			if (trainingOnly) { op["producer_template"]=toGodot(o->getTemplate()->getName()); op["queue_count"]=0; }
+			if (builder && modelOnly) {
+				struct Site { Dictionary op; float share, travel, exposure, homeDistance; };
+				std::vector<Site> sites;
+				const auto *resource=TerrainResourceClaimView::resourceDataOf(*tt);
+				const bool economy=resource && resource->m_maxIncome>0;
+				for (float radius:{220.0f,380.0f,560.0f,900.0f,1200.0f}) for (int direction=0;direction<8;++direction) {
+					const float angle=direction*0.785398163f;
+					Coord3D at{std::round(o->getPosition()->x+radius*std::cos(angle)),std::round(o->getPosition()->y+radius*std::sin(angle)),0}; at.z=logic.getGroundHeight(at.x,at.y);
+					if (m_game->shroud().getStatusAt((int)playerIndex,at.x,at.y)!=0 || !dozer->siteIsLegal(*tt,at,0.0f,*p)) continue;
+					Dictionary site=op.duplicate(true); site["x"]=at.x; site["y"]=at.y;
+					const float travel=std::hypot(at.x-o->getPosition()->x,at.y-o->getPosition()->y);
+					const float fromHome=home ? std::hypot(at.x-home->getPosition()->x,at.y-home->getPosition()->y) : travel;
+					float exposure=0,nearest=10000; int pendingOverlap=0;
+					for (int j=0;j<visibleEnemies.size();++j) { Dictionary enemy=visibleEnemies[j]; if (!(bool)enemy.get("armed",false)) continue; if (std::hypot(at.x-(double)enemy["x"],at.y-(double)enemy["y"])<900) exposure+=(double)enemy.get("public_cost",0); }
+					for (const ::Object *farm:friendlyFarms) {
+						const float distance=std::hypot(at.x-farm->getPosition()->x,at.y-farm->getPosition()->y); nearest=std::min(nearest,distance);
+						const auto *other=TerrainResourceClaimView::resourceDataOf(*farm->getTemplate());
+						if (economy && farm->isUnderConstruction() && distance<resource->m_radius+other->m_radius) ++pendingOverlap;
+					}
+					const float share=economy ? TerrainResourceClaimView::claimableFraction(logic,at.x,at.y,resource->m_radius,resource->m_highPriority,(int)playerIndex) : 0;
+					site["farm_share"]=share; site["economy"]=economy; site["builder_distance"]=travel; site["home_distance"]=fromHome;
+					site["nearest_farm_distance"]=nearest; site["pending_farm_overlap"]=pendingOverlap; site["visible_threat_value"]=exposure;
+					site["base_income_per_second"]=economy && resource->m_incomeInterval>0 ? resource->m_maxIncome*share*5.0/(double)resource->m_incomeInterval : 0.0;
+					site["income_estimate_is_base"]=true; site["wall_seed"]=wall;
+					site["id"]=toGodot("build:"+std::to_string(o->getID())+":"+name+":"+std::to_string((int)at.x)+":"+std::to_string((int)at.y));
+					sites.push_back({site,share,travel,exposure,fromHome});
+				}
+				if (sites.empty()) continue;
+				std::vector<size_t> choices;
+				auto choose=[&](auto score) { size_t best=0; for (size_t j=1;j<sites.size();++j) if (score(sites[j])>score(sites[best])) best=j; if (std::find(choices.begin(),choices.end(),best)==choices.end()) choices.push_back(best); };
+				// Offer different tradeoffs; do not choose the model's preferred site.
+				choose([&](const Site &s) { return economy ? s.share : -s.exposure; });
+				choose([](const Site &s) { return -s.travel; });
+				choose([](const Site &s) { return -s.exposure-s.homeDistance*.001f; });
+				for (size_t j=0;choices.size()<3 && j<sites.size();++j) if (std::find(choices.begin(),choices.end(),j)==choices.end()) choices.push_back(j);
+				for (size_t j:choices) { out.push_back(sites[j].op); if (out.size()>=64) return out; }
+				continue;
+			}
+			if (builder)
+			{
+				bool found = false;
+				for (float radius : {220.0f, 380.0f, 560.0f, 900.0f, 1200.0f})
+				{
+					for (int direction = 0; direction < 8 && !found; ++direction)
+					{
+						const float angle = direction * 0.785398163f;
+						Coord3D at{ o->getPosition()->x + radius * std::cos(angle), o->getPosition()->y + radius * std::sin(angle), 0.0f };
+						at.z = logic.getGroundHeight(at.x, at.y);
+						if (m_game->shroud().getStatusAt((int)playerIndex, at.x, at.y) != 0 || !dozer->siteIsLegal(*tt, at, 0.0f, *p)) continue;
+						if (tt->getName()==ai->army->economyTemplate)
+						{
+							const float share=AIBaseBuilder::modelFarmQuality(logic,*p,*tt,at);
+							if (!ai->build.units.modelOnlyControl && share<0.70f) continue;
+							op["farm_share"]=share;
+						}
+						op["x"] = at.x; op["y"] = at.y; found = true;
+					}
+					if (found) break;
+				}
+				if (!found) continue;
+			}
+			op["id"] = toGodot(std::string(builder ? "build:" : "train:") + std::to_string(o->getID()) + ":" + name);
+			out.push_back(op); offered.insert(name);
+			if (out.size() >= ((trainingOnly || controlled) ? 64 : 20)) return out;
+		}
+	}
+	return out;
+}
+
+Dictionary GameWorld::strategy_produce(int64_t playerIndex, const Dictionary &operation)
+{
+	Dictionary out; out["ok"] = false;
+	if (!m_game || m_netStarted || m_replayPlayback || m_saveLoad) return out;
+	// Resolve the offered ID again, never execute caller-supplied templates or coordinates.
+	const String id = operation.get("id", "");
+	const Array legal = strategy_production_options(playerIndex);
+	Dictionary chosen;
+	for (int i = 0; i < legal.size(); ++i) { Dictionary candidate = legal[i]; if (String(candidate["id"]) == id) { chosen = candidate; break; } }
+	if (chosen.is_empty()) { out["reason"] = "purchase_no_longer_legal"; return out; }
+	if (String(chosen["kind"]) == "build")
+		out = strategy_construct(playerIndex, (int64_t)chosen["producer"], chosen["template"], (double)chosen["x"], (double)chosen["y"]);
+	else
+	{
+		queue_unit(playerIndex, (int64_t)chosen["producer"], chosen["template"], false);
+		out["ok"] = true;
+	}
+	if ((bool)out["ok"])
+	{
+		AISkirmishPlayer *ai = m_game->logic().skirmishAI().findAI((int)playerIndex);
+		ai->build.units.strategySpendUntil = (int)m_game->logic().getFrame() + 2;
+		out["operation"] = chosen; out["status"] = "submitted";
+	}
+	return out;
+}
+
+Dictionary GameWorld::strategy_construct(int64_t playerIndex, int64_t builderId, const String &templateName, double x, double y)
+{
+	Dictionary out; out["ok"] = false;
+	if (!m_game || m_netStarted || m_replayPlayback || m_saveLoad || !std::isfinite(x) || !std::isfinite(y)) return out;
+	m_game->drainFrames();
+	const auto worldContext = m_world ? m_world->enterContext() : nullptr;
+	GameLogic &logic = m_game->logic();
+	Player *p = logic.players().getNthPlayer((int)playerIndex);
+	::Object *builder = logic.findObjectByID((::ObjectID)builderId);
+	if (!p || !p->getPlayerTemplate() || p->getPlayerType() != PLAYER_COMPUTER || !builder || builder->getControllingPlayer() != p || builder->isEffectivelyDead()) return out;
+	const AISkirmishPlayer *ai = logic.skirmishAI().findAI((int)playerIndex);
+	if (!ai || !ai->store->data().enhancedCounterProduction) return out;
+	if ((int)logic.getFrame() < ai->build.units.strategySpendUntil) { out["reason"] = "model_purchase_pending"; return out; }
+	if (ai->store->data().classicOpening && !ai->build.units.classicDone && !ai->build.units.modelOnlyControl && (int)logic.getFrame()>=ai->build.units.trainingControlUntil) { out["reason"] = "classic_opening_controls_construction"; return out; }
+	DozerAIUpdate *dozer = dynamic_cast<DozerAIUpdate *>(builder->getAIUpdateInterface());
+	if (!dozer || dozer->getCurrentTask() != DozerAIUpdate::DOZER_TASK_INVALID || dozer->isAnyTaskPending()) { out["reason"] = "builder_busy"; return out; }
+	const std::string name = templateName.utf8().get_data();
+	const ThingTemplate *tt = name.empty() ? nullptr : logic.things().findTemplate(name);
+	const int structureBit = ObjectTemplateInfoBuilder::kindOfIndex("STRUCTURE");
+	if (tt && strategyStandaloneWall(logic,*tt)) {
+		if (!ai->build.units.modelOnlyControl) { out["reason"]="wall_requires_connected_plan"; return out; }
+		for (::Object *object=logic.getFirstObject();object;object=object->getNextObject())
+			if (object->getControllingPlayer()==p && !object->isEffectivelyDead() && WallHubBehavior::find(*object,0)) { out["reason"]="extend_existing_wall_hub"; return out; }
+	}
+	if (!tt || structureBit < 0 || !MaskTest(logic.templateInfo(tt->getFinalOverride()).kindOf, (unsigned)structureBit) || !BuildAssistant::isInProducersCommandSet(*builder, tt, -1) || BuildAssistant::canMakeUnit(*builder, tt, -1) != CANMAKE_OK) { out["reason"] = "not_buildable_or_unaffordable"; return out; }
+	Coord3D at{ (float)x, (float)y, logic.getGroundHeight((float)x, (float)y) };
+	if (m_game->shroud().getStatusAt((int)playerIndex, at.x, at.y) != 0) { out["reason"] = "unexplored"; return out; }
+	if (!dozer->siteIsLegal(*tt, at, 0.0f, *p)) { out["reason"] = "illegal_site"; return out; }
+	if (!ai->build.units.modelOnlyControl && name==ai->army->economyTemplate && AIBaseBuilder::modelFarmQuality(logic,*p,*tt,at)<0.70f) { out["reason"]="farm_below_70_percent"; return out; }
+	GameMessage selected(MSG_CREATE_SELECTED_GROUP, (int)playerIndex);
+	selected.appendBooleanArgument(true); selected.appendObjectIDArgument((::ObjectID)builderId);
+	m_game->commands().append(selected);
+	GameMessage build(MSG_DOZER_CONSTRUCT, (int)playerIndex);
+	build.appendIntegerArgument(tt->getTemplateID()); build.appendLocationArgument(at); build.appendRealArgument(0.0f);
+	m_game->commands().append(build);
+	out["ok"] = true; out["template"] = toGodot(name);
+	return out;
+}
+
 } // namespace godot
