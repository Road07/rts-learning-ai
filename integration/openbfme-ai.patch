+		u.classicStage=3;
+		if (thrall)
+		{
+			auto *pu=thrall->getProductionUpdate();
+			const UpgradeTemplate *upgrade=TheUpgradeCenter ? TheUpgradeCenter->findUpgrade("Upgrade_ThrallMasterOrcWarriors") : nullptr;
+			if (pu && upgrade && pu->getProductionCount()==0 && pu->queueUpgrade(upgrade)) { u.classicAction="first_swords_summon"; u.classicActionFrame=(int)logic.getFrame(); }
+		}
+		else if (auto *pu=producer->getProductionUpdate())
+		{
+			const ThingTemplate *tt=logic.things().findTemplate(choice->recruit);
+			if (tt && pu->getProductionCount()==0 && BuildAssistant::isInProducersCommandSet(*producer,tt,-1) && BuildAssistant::canMakeUnit(*producer,tt,-1)==CANMAKE_OK)
+				if (pu->queueCreateUnit(tt->getFinalOverride(),-1,pu->requestUniqueUnitID(),-1,false,std::string(),false)) { u.classicAction="first_swords_queued"; u.classicActionFrame=(int)logic.getFrame(); }
+		}
+	}
+	else if (farms<3) { u.classicStage=4; build=ai.army->economyTemplate.c_str(); farm=true; }
+	else
+	{
+		u.classicStage=5;
+		if (!u.classicDone) { u.classicAction="opening_complete"; u.classicActionFrame=(int)logic.getFrame(); }
+		u.classicDone=true;
+		return false;
+	}
+	// Resume unfinished essential construction when its original builder is lost.
+	if (!build && !unfinished) for (Object *o=logic.getFirstObject();o;o=o->getNextObject())
+		if (o->getControllingPlayer()==&player && !o->isEffectivelyDead() && o->isUnderConstruction() && o->getTemplate()->getName()==ai.army->economyTemplate) { unfinished=o; break; }
+	if (unfinished)
+	{
+		bool assigned=false;
+		for (Object *o:builders) if (auto *d=dynamic_cast<DozerAIUpdate *>(o->getAIUpdateInterface())) if (d->getTaskTarget(DozerAIUpdate::DOZER_TASK_BUILD)==unfinished->getID()) assigned=true;
+		if (!assigned) for (Object *o:builders) if (auto *d=dynamic_cast<DozerAIUpdate *>(o->getAIUpdateInterface()))
+			if (d->getCurrentTask()==DozerAIUpdate::DOZER_TASK_INVALID && !d->isAnyTaskPending()) { d->resumeConstruction(*unfinished); break; }
+	}
+	if (build && (int)logic.getFrame()-u.classicRetryFrame>=5)
+	{
+		u.classicRetryFrame=(int)logic.getFrame();
+		const ThingTemplate *tt=logic.things().findTemplate(build);
+		for (Object *builder:builders)
+		{
+			auto *dozer=dynamic_cast<DozerAIUpdate *>(builder->getAIUpdateInterface());
+			if (!tt || !dozer || dozer->getCurrentTask()!=DozerAIUpdate::DOZER_TASK_INVALID || dozer->isAnyTaskPending() || dozer->isMoving() || !BuildAssistant::isInProducersCommandSet(*builder,tt,-1) || BuildAssistant::canMakeUnit(*builder,tt,-1)!=CANMAKE_OK) continue;
+			Coord3D best{}; float share=-1;
+			for (float radius : {350.0f,550.0f,750.0f,950.0f})
+			{
+				for (int i=0;i<16;++i)
+				{
+					const float angle=float(i)*0.3926990817f;
+					Coord3D at{ai.build.startPosition.x+radius*std::cos(angle),ai.build.startPosition.y+radius*std::sin(angle),0}; at.z=logic.getGroundHeight(at.x,at.y);
+					if (!logic.shroud() || logic.shroud()->getStatusAt(ai.playerIndex,at.x,at.y)!=CELLSHROUD_CLEAR || !dozer->siteIsLegal(*tt,at,0,player)) continue;
+					const float quality=farm ? classicFarmQuality(logic,player,*tt,at) : 1.0f;
+					if (quality>share) { share=quality; best=at; }
+					if (share>=0.97f) break;
+				}
+				if (share>=0.97f) break;
+			}
+			if (share<(farm ? 0.70f : 0.0f)) continue;
+			if (dozer->construct(*tt,best,0,player))
+			{
+				u.classicAction=farm ? (u.classicDone ? "farm_rebuilt" : "farm_started") : (repairProducer ? "sword_building_rebuilt" : "sword_building_started");
+				u.classicActionFrame=(int)logic.getFrame(); if (farm) u.classicFarmShare=share; else u.classicProducerStarted=true;
+				break;
+			}
+		}
+	}
+	return !u.classicDone && !u.classicFirstSword;
+}
